# Copy to .env.docker. Credentials are read by the API at runtime only.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TUTOR_MODEL=gpt-6-luna
OPENAI_LESSON_MODEL=gpt-6-luna
OPENAI_EVALUATION_MODEL=gpt-6-luna
OPENAI_SEARCH_MODEL=gpt-6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=coral
ENABLE_FIXTURES=false

# Optional alternate provider. Select AI_PROVIDER=openrouter explicitly.
OPENROUTER_API_KEY=
