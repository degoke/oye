# Copy this file to .env. Keep credentials out of version control.
API_PORT=3187
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5187
DATABASE_PATH=.data/oye.sqlite
MEDIA_PATH=.data/media
OPENAI_API_KEY=
# OpenAI and the OpenAI Agents SDK are the default. Keys stay on the server.
AI_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TUTOR_MODEL=openai/gpt-6-luna
OPENROUTER_LESSON_MODEL=openai/gpt-6-luna
OPENROUTER_EVALUATION_MODEL=openai/gpt-6-luna
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TUTOR_MODEL=gpt-6-luna
OPENAI_LESSON_MODEL=gpt-6-luna
OPENAI_EVALUATION_MODEL=gpt-6-luna
OPENAI_SEARCH_MODEL=gpt-6-luna
AI_MAX_OUTPUT_TOKENS=6000
ENABLE_FIXTURES=false

# Speech uses the selected AI_PROVIDER. Model IDs are explicit; there is no fallback.
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_MODEL_YO=google/gemini-3.8-flash-tts
OPENROUTER_TTS_MODEL_HA=google/gemini-3.8-flash-tts
OPENROUTER_TTS_MODEL_IG=google/gemini-3.8-flash-tts
OPENROUTER_TTS_VOICE=Kore
# Yoruba speech is experimental and is checked against the script.
OPENROUTER_TTS_VOICE_YO=Puck
OPENROUTER_TTS_VOICE_IG=Puck
OPENROUTER_STT_MODEL=google/gemini-3.5-transcribe
OPENROUTER_NARRATION_STT_MODEL_YO=elevenlabs/scribe-v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FONT_FAMILY=Arial

# Direct OpenAI voice replies (server only; requires OPENAI_API_KEY)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=coral
